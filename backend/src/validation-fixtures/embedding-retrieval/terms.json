    { "id": "statin", "set": "failure", "query": "statin", "dictionary": "prescriptions_drug", "right": { "drug_class": "statins" }, "trap": { "label_contains": ["nystatin"] }, "note": "2026-09-27: statin -> nystatin by substring" },
