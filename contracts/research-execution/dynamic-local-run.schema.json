{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/research-execution/dynamic-local-run.schema.json",
  "title": "Dynamic local MIMIC research run artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "status", "evidence_level", "study", "manifest", "data_provenance", "diagnostic_decision", "blockers", "warnings", "reproducibility_id", "integrity_id"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "run_id": { "type": "string", "pattern": "^run:[a-f0-9]{20}$" },
    "created_at": { "type": "string", "minLength": 20 },
    "status": { "enum": ["completed", "blocked"] },
    "evidence_level": { "enum": ["local_mimic_archive_execution", "pre_execution_block"] },
    "study": { "type": "object" },
    "manifest": { "type": "object" },
    "data_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_source_id", "data_source_version", "archive_sha256"],
      "properties": {
        "data_source_id": { "type": "string", "minLength": 1 },
        "data_source_version": { "type": "string", "minLength": 1 },
        "archive_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "cohort": { "type": "object" },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "study_family", "outcome_structure", "registered_method_id", "registered_method_version", "method", "counts", "estimates", "diagnostics", "sensitivity", "publication_outputs", "runtime"],
      "properties": {
        "status": { "const": "completed" },
        "study_family": { "enum": ["association", "prediction", "treatment_effect"] },
        "outcome_structure": { "enum": ["binary", "continuous", "count", "time_to_event", "repeated_measure", "competing_risk"] },
        "registered_method_id": { "type": "string", "pattern": "^(association|prediction|treatment_effect)\\.(binary|continuous|count|time_to_event|repeated_measure|competing_risk)\\.v[0-9]+$" },
        "registered_method_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "method": { "type": "string", "minLength": 1 },
        "counts": { "type": "object" },
        "estimates": { "type": "object" },
        "diagnostics": { "type": "object" },
        "sensitivity": { "type": "object" },
        "publication_outputs": { "$ref": "#/$defs/publication_outputs" },
        "runtime": { "type": "object" }
      }
    },
    "diagnostic_decision": { "enum": ["reportable", "reportable_with_warnings", "blocked"] },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "code", "message"],
        "properties": {
          "stage": { "enum": ["research_design", "variable_mapping", "manifest", "data", "statistics"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reproducibility_id": { "$ref": "#/$defs/digest" },
    "integrity_id": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "tabular_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "columns", "rows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "publication_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables", "listings", "figures"],
      "properties": {
        "tables": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/tabular_output" } },
        "listings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "columns", "rows", "privacy"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
              "privacy": { "const": "aggregate_only" }
            }
          }
        },
        "figures": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "mime_type", "content"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "mime_type": { "const": "image/svg+xml" }, "content": { "type": "string", "pattern": "^<svg" } } } }
      }
    }
  }
}
