{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized_label_en", "synonyms", "code_hints", "category", "ambiguities"],
  "properties": {
    "normalized_label_en": { "type": "string", "minLength": 2, "maxLength": 120 },
    "synonyms": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 2, "maxLength": 120 } },
    "code_hints": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^(?=.*[0-9])[A-Za-z0-9.]{2,12}$" } },
    "category": { "enum": ["demographic", "encounter", "vital_sign", "laboratory", "medication", "intervention", "diagnosis", "score", "outcome", "unknown"] },
    "ambiguities": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "explanation"],
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 120 },
          "explanation": { "type": "string", "minLength": 2, "maxLength": 300 }
        }
      }
    }
  }
}
